# 서버 포트 설정
server:
  port: SERVER_PORT # 로컬에서 실행될 서버 포트

# 스프링 설정
spring:
  # 데이터베이스 설정 (로컬 MySQL 기준)
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://{DB_HOST}?useSSL=false&allowPublicKeyRetrieval=true
    username: YOUR_LOCAL_DB_USERNAME # 로컬 DB 사용자 이름 (본인 환경에 맞게 수정)
    password: YOUR_LOCAL_DB_PASSWORD # 로컬 DB 비밀번호 (본인 환경에 맞게 수정)

  # JPA(ORM) 설정
  jpa:
    hibernate:
      ddl-auto: update # 애플리케이션 실행 시 엔티티에 맞춰 테이블 구조 자동 변경 (개발용)
    properties:
      hibernate:
        show_sql: true # 실행되는 SQL 쿼리를 로그로 보여줌
        format_sql: true # SQL 로그를 예쁘게 포맷팅

  cloud:
    aws:
      region:
        static: AWS_S3_REGION # S3 버킷이 있는 리전
      stack:
        auto: false
      credentials:
        # 로컬 개발 시에는 아래 access/secret key를 직접 입력하거나,
        # AWS CLI에 설정된 기본 프로필을 사용합니다.
        # 프로덕션(EB) 환경에서는 EB의 IAM 역할(Role)을 통해 자동으로 주입되므로 이 부분이 없어도 됩니다.
        access-key: YOUR_AWS_IAM_ACCESS_KEY
        secret-key: YOUR_AWS_IAM_SECRET_KEY

s3:
  bucket: AWS_S3_BUCKET_NAME # 생성하신 S3 버킷 이름을 입력하세요.

# JWT 설정
jwt:
  secret: JWT_SECRET # ❗️반드시 아무도 모르는 긴 문자열로 변경하세요.
  expiration-time: 86400000 # 토큰 유효 기간 (24시간, 밀리초 단위)

# Kakao API 설정
kakao:
  api:
    url: https://kapi.kakao.com
  rest-api-key: KAKAO_REST_API_KEY
  admin-key: KAKAO_ADMIN_KEY

# firebase 설정
firebase:
  service-account-path: FIREBASE_SERVICE_ACCOUNT_PATH

logging:
  level:
    # 전역 로그 레벨: INFO 레벨 이상의 로그만 출력
    root: INFO
    # 우리 앱 패키지(kr.heeblings)에 대해서는 INFO 레벨의 상세한 로그까지 모두 출력
    kr.heeblings: INFO
    # Hibernate가 생성하는 SQL 로그는 너무 길어지므로 INFO 레벨로 제한 (필요시 DEBUG로 변경)
    org.hibernate.SQL: INFO
